@model WorkshopDto
@{
    ViewData["Title"] = Model.Title;
    var duration = Model.EndDateTime - Model.StartDateTime;
    var durationHours = duration.TotalHours;
    var isFull = Model.AvailableSlots <= 0;
    var occupancyPercent = Model.Capacity > 0 ? (int)Math.Round((double)Model.ActiveEnrollments / Model.Capacity * 100) : 0;
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Volver a Talleres
    </a>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card card-custom p-4 p-md-5 border-0 shadow-sm mb-4">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-3 py-2 rounded-pill">
                    <i class="bi bi-tag-fill me-1"></i> @Model.Code
                </span>
                @if (isFull)
                {
                    <span class="badge-full">
                        <i class="bi bi-slash-circle me-1"></i> Cupos Agotados
                    </span>
                }
                else
                {
                    <span class="badge-slots">
                        <i class="bi bi-check-circle-fill me-1"></i> @Model.AvailableSlots cupos disponibles
                    </span>
                }
            </div>

            <h1 class="h2 fw-bold text-dark mb-3">@Model.Title</h1>

            <div class="mb-4">
                <h5 class="fw-semibold text-secondary mb-2">Descripción del Taller</h5>
                <p class="text-muted lead fs-6" style="white-space: pre-line;">@Model.Description</p>
            </div>

            <hr class="my-4 text-muted opacity-25" />

            <h5 class="fw-semibold text-secondary mb-3">Instructor Asignado</h5>
            <div class="d-flex align-items-center p-3 rounded-3 bg-light">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 me-3">
                    <i class="bi bi-person-video3 fs-4"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">@(Model.InstructorName ?? "Por confirmar")</h6>
                    @if (!string.IsNullOrEmpty(Model.InstructorEmail))
                    {
                        <small class="text-muted">
                            <i class="bi bi-envelope me-1"></i> @Model.InstructorEmail
                        </small>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card card-custom p-4 border-0 shadow-sm sticky-top" style="top: 100px;">
            <h5 class="fw-bold mb-3 text-dark">Información de la Sesión</h5>

            <div class="mb-3">
                <small class="text-muted d-block mb-1">Fecha y Hora de Inicio</small>
                <div class="fw-semibold text-dark">
                    <i class="bi bi-calendar-check text-primary me-2"></i>
                    @Model.StartDateTime.ToString("dddd, dd MMMM yyyy")
                </div>
                <div class="text-secondary small ms-4">
                    @Model.StartDateTime.ToString("hh:mm tt")
                </div>
            </div>

            <div class="mb-3">
                <small class="text-muted d-block mb-1">Fecha y Hora de Finalización</small>
                <div class="fw-semibold text-dark">
                    <i class="bi bi-calendar-x text-primary me-2"></i>
                    @Model.EndDateTime.ToString("dddd, dd MMMM yyyy")
                </div>
                <div class="text-secondary small ms-4">
                    @Model.EndDateTime.ToString("hh:mm tt") (@durationHours.ToString("0.#") horas)
                </div>
            </div>

            <hr class="my-3 text-muted opacity-25" />

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <small class="text-muted">Capacidad y Ocupación</small>
                    <span class="small fw-semibold text-dark">@Model.ActiveEnrollments / @Model.Capacity cupos</span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar @(isFull ? "bg-danger" : "bg-primary")" role="progressbar" style="width: @occupancyPercent%;" aria-valuenow="@occupancyPercent" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
            </div>

            <div class="pt-3">
                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Participant"))
                {
                    @if (!isFull)
                    {
                        <form asp-action="Enroll" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary w-100 py-2">
                                <i class="bi bi-bookmark-plus me-1"></i> Inscribirme Ahora
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary w-100 py-2 disabled" disabled>
                            <i class="bi bi-x-circle me-1"></i> Taller Lleno
                        </button>
                    }
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="alert alert-info small mb-0 rounded-3">
                        <i class="bi bi-info-circle me-1"></i> Tu rol de empleado te permite gestionar talleres y visualizar reportes en el sistema.
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary w-100 py-2 mb-2">
                        Iniciar Sesión para Inscribirte
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary w-100 py-2">
                        Registrar una Cuenta
                    </a>
                }
            </div>
        </div>
    </div>
</div>
