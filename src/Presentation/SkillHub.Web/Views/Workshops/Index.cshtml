@model IEnumerable<WorkshopDto>
@{
    ViewData["Title"] = "Catálogo de Talleres";
    var search = ViewBag.SearchTerm as string;
}

<div class="row align-items-center mb-4 g-3">
    <div class="col-12 col-md-7">
        <h1 class="h2 fw-bold text-dark mb-1">
            <i class="bi bi-mortarboard text-primary me-2"></i>Talleres Disponibles
        </h1>
        <p class="text-muted mb-0">Explora nuestra oferta de talleres prácticos y asegura tu cupo</p>
    </div>
    <div class="col-12 col-md-5">
        <form method="get" asp-action="Index" class="d-flex gap-2">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Buscar por título, código o instructor..." value="@search" />
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary border-start-0" title="Limpiar búsqueda">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
            <button type="submit" class="btn btn-primary rounded-3 px-3">
                Buscar
            </button>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card card-custom p-5 text-center my-4">
        <div class="d-inline-flex p-3 rounded-circle bg-light text-muted mb-3 mx-auto">
            <i class="bi bi-calendar-x fs-1"></i>
        </div>
        <h4 class="fw-bold text-secondary">No se encontraron talleres disponibles</h4>
        <p class="text-muted mb-3">
            @(string.IsNullOrWhiteSpace(search)
                ? "Actualmente no hay talleres futuros programados en la plataforma."
                : $"No se encontraron coincidencias para '{search}'. Intenta con otro término.")
        </p>
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <div>
                <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                    Ver todos los talleres
                </a>
            </div>
        }
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var workshop in Model)
        {
            var isFull = workshop.AvailableSlots <= 0;
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card card-custom h-100 d-flex flex-column p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-3 py-2 rounded-pill">
                            <i class="bi bi-tag-fill me-1"></i> @workshop.Code
                        </span>
                        @if (isFull)
                        {
                            <span class="badge-full">
                                <i class="bi bi-slash-circle me-1"></i> Agotado
                            </span>
                        }
                        else
                        {
                            <span class="badge-slots">
                                <i class="bi bi-check-circle-fill me-1"></i> @workshop.AvailableSlots de @workshop.Capacity cupos
                            </span>
                        }
                    </div>

                    <h5 class="fw-bold mb-2 text-dark">@workshop.Title</h5>
                    <p class="text-muted small flex-grow-1 mb-3" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                        @workshop.Description
                    </p>

                    <div class="bg-light p-3 rounded-3 mb-3 small">
                        <div class="d-flex align-items-center mb-2 text-secondary">
                            <i class="bi bi-person-badge text-primary me-2 fs-6"></i>
                            <span class="fw-semibold text-dark">@(workshop.InstructorName ?? "Por asignar")</span>
                        </div>
                        <div class="d-flex align-items-center mb-2 text-secondary">
                            <i class="bi bi-calendar-event text-primary me-2 fs-6"></i>
                            <span>@workshop.StartDateTime.ToString("dd MMM yyyy, hh:mm tt")</span>
                        </div>
                        <div class="d-flex align-items-center text-secondary">
                            <i class="bi bi-clock text-primary me-2 fs-6"></i>
                            <span>Hasta @workshop.EndDateTime.ToString("hh:mm tt")</span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-auto">
                        <a asp-action="Details" asp-route-id="@workshop.Id" class="btn btn-outline-secondary w-100 rounded-3">
                            <i class="bi bi-info-circle me-1"></i> Detalles
                        </a>
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Participant"))
                        {
                            @if (!isFull)
                            {
                                <form asp-action="Enroll" asp-route-id="@workshop.Id" method="post" class="w-100">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary w-100 rounded-3">
                                        <i class="bi bi-bookmark-plus me-1"></i> Inscribirme
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100 rounded-3 disabled" disabled>
                                    Lleno
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
