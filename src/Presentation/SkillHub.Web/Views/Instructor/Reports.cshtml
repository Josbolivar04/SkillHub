@model IReadOnlyList<TopWorkshopReportDto>
@{
    ViewData["Title"] = "Talleres Más Demandados";
    var totalEnrollments = Model.Sum(m => m.ActiveEnrollments);
    var totalCapacity = Model.Sum(m => m.Capacity);
    var avgOccupancy = totalCapacity > 0 ? Math.Round((double)totalEnrollments / totalCapacity * 100, 1) : 0;
    var topWorkshop = Model.FirstOrDefault();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="h2 fw-bold text-dark mb-1">
            <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Talleres Más Demandados
        </h1>
        <p class="text-muted mb-0">Listado de talleres ordenados de mayor a menor número de inscripciones activas</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ImportExcel" class="btn btn-outline-primary rounded-pill px-4">
            <i class="bi bi-file-earmark-excel me-1"></i> Inscripción Masiva
        </a>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Taller
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card card-custom p-3 h-100">
            <small class="text-muted">Total de Talleres</small>
            <div class="fs-3 fw-bold text-dark">@Model.Count</div>
            <small class="text-secondary">En catálogo general</small>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card card-custom p-3 h-100">
            <small class="text-muted">Inscripciones Activas</small>
            <div class="fs-3 fw-bold text-success">@totalEnrollments</div>
            <small class="text-secondary">Participantes registrados</small>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card card-custom p-3 h-100">
            <small class="text-muted">Ocupación Promedio</small>
            <div class="fs-3 fw-bold text-primary">@avgOccupancy%</div>
            <small class="text-secondary">De la capacidad ofertada</small>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card card-custom p-3 h-100">
            <small class="text-muted">Taller Más Solicitado</small>
            <div class="fs-6 fw-bold text-dark text-truncate" title="@(topWorkshop?.Title ?? "N/A")">
                @(topWorkshop?.Title ?? "N/A")
            </div>
            <small class="text-success fw-semibold">
                @(topWorkshop != null ? $"{topWorkshop.ActiveEnrollments} inscritos ({topWorkshop.OccupancyPercentage}%)" : "-")
            </small>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card card-custom p-5 text-center">
        <div class="d-inline-flex p-3 rounded-circle bg-light text-muted mb-3 mx-auto">
            <i class="bi bi-inbox fs-1"></i>
        </div>
        <h4 class="fw-bold text-secondary">No hay talleres registrados</h4>
        <p class="text-muted mb-0">Cuando se creen talleres en la plataforma podrás consultar este reporte.</p>
    </div>
}
else
{
    <div class="card card-custom border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="top-workshops-table">
                <thead class="table-light text-secondary small text-uppercase fw-semibold">
                    <tr>
                        <th class="ps-4 py-3 text-center" style="width: 60px;">#</th>
                        <th class="py-3">Taller</th>
                        <th class="py-3">Instructor</th>
                        <th class="py-3 text-center">Inscritos Activos</th>
                        <th class="py-3 text-center">Cupos Libres</th>
                        <th class="py-3">Ocupación (%)</th>
                        <th class="pe-4 py-3 text-end">Detalles</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rank = 1; }
                    @foreach (var w in Model)
                    {
                        var isTop3 = rank <= 3;
                        <tr>
                            <td class="ps-4 py-3 text-center">
                                @if (rank == 1)
                                {
                                    <span class="badge bg-warning text-dark rounded-circle p-2 fs-6" title="Primer lugar en demanda">
                                        🥇
                                    </span>
                                }
                                else if (rank == 2)
                                {
                                    <span class="badge bg-light text-secondary border rounded-circle p-2 fs-6" title="Segundo lugar">
                                        🥈
                                    </span>
                                }
                                else if (rank == 3)
                                {
                                    <span class="badge bg-light text-danger border rounded-circle p-2 fs-6" title="Tercer lugar">
                                        🥉
                                    </span>
                                }
                                else
                                {
                                    <span class="fw-bold text-muted">@rank</span>
                                }
                            </td>
                            <td class="py-3">
                                <div class="fw-bold text-dark">@w.Title</div>
                                <span class="badge bg-light text-muted border small"><i class="bi bi-tag me-1"></i>@w.Code</span>
                            </td>
                            <td class="py-3 small text-secondary">
                                <i class="bi bi-person-video3 me-1 text-primary"></i>
                                @(w.InstructorName ?? "Sin asignar")
                            </td>
                            <td class="py-3 text-center">
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill fw-bold fs-6">
                                    @w.ActiveEnrollments / @w.Capacity
                                </span>
                            </td>
                            <td class="py-3 text-center">
                                @if (w.AvailableSlots <= 0)
                                {
                                    <span class="badge-full">Agotados</span>
                                }
                                else
                                {
                                    <span class="badge-slots">@w.AvailableSlots libres</span>
                                }
                            </td>
                            <td class="py-3" style="min-width: 170px;">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-semibold">@w.OccupancyPercentage%</span>
                                    <span class="text-muted">Capacidad @w.Capacity</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar @(w.OccupancyPercentage >= 100 ? "bg-danger" : w.OccupancyPercentage >= 70 ? "bg-warning" : "bg-primary")"
                                         style="width: @Math.Min(100, (int)w.OccupancyPercentage)%;"></div>
                                </div>
                            </td>
                            <td class="pe-4 py-3 text-end">
                                <a asp-controller="Workshops" asp-action="Details" asp-route-id="@w.WorkshopId" class="btn btn-outline-secondary btn-sm rounded-3">
                                    <i class="bi bi-eye me-1"></i> Ver
                                </a>
                            </td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
    </div>
}
