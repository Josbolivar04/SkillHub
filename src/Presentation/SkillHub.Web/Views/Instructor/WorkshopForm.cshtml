@model WorkshopFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? $"Editar {Model.Code}" : "Nuevo Taller";
    var action = Model.IsEdit ? "Edit" : "Create";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Volver a Mis Talleres
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-8">
        <div class="card card-custom p-4 p-md-5 border-0 shadow-sm">
            <div class="d-flex align-items-center mb-4">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 me-3">
                    <i class="bi @(Model.IsEdit ? "bi-pencil-square" : "bi-calendar-plus") fs-4"></i>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-0">@(Model.IsEdit ? "Editar Taller" : "Crear Nuevo Taller")</h1>
                    <p class="text-muted small mb-0">
                        @(Model.IsEdit ? "Actualiza la información, horario o capacidad del taller." : "El taller quedará asignado a ti como instructor.")
                    </p>
                </div>
            </div>

            @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger rounded-3 py-2 small">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-0"></div>
                </div>
            }

            <form asp-action="@action" asp-route-id="@Model.Id" method="post" id="workshop-form" novalidate>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ActiveEnrollments" />

                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label asp-for="Code" class="form-label fw-semibold text-secondary small"></label>
                        @if (Model.IsEdit)
                        {
                            <input asp-for="Code" class="form-control bg-light" readonly />
                            <div class="form-text">El código no se puede modificar.</div>
                        }
                        else
                        {
                            <input asp-for="Code" class="form-control text-uppercase" placeholder="FOT-101" />
                        }
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-8">
                        <label asp-for="Title" class="form-label fw-semibold text-secondary small"></label>
                        <input asp-for="Title" class="form-control" placeholder="Fotografía para principiantes" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold text-secondary small"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="¿Qué aprenderán los participantes?"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="StartDateTime" class="form-label fw-semibold text-secondary small"></label>
                        <input asp-for="StartDateTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                        <span asp-validation-for="StartDateTime" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="EndDateTime" class="form-label fw-semibold text-secondary small"></label>
                        <input asp-for="EndDateTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                        <span asp-validation-for="EndDateTime" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Capacity" class="form-label fw-semibold text-secondary small"></label>
                        <input asp-for="Capacity" type="number" min="1" class="form-control" />
                        @if (Model.IsEdit)
                        {
                            <div class="form-text">Inscritos activos actualmente: <strong>@Model.ActiveEnrollments</strong>. La capacidad no puede ser menor.</div>
                        }
                        <span asp-validation-for="Capacity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancelar</a>
                    <button type="submit" id="btn-save-workshop" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-check2-circle me-1"></i> @(Model.IsEdit ? "Guardar Cambios" : "Crear Taller")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
