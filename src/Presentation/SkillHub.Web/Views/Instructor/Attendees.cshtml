@model IEnumerable<WorkshopAttendeeDto>
@{
    var workshop = (WorkshopDto)ViewBag.Workshop;
    ViewData["Title"] = $"Inscritos - {workshop.Code}";
    var active = Model.Where(a => a.Status == "Active").ToList();
    var cancelled = Model.Where(a => a.Status != "Active").ToList();
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Volver a Mis Talleres
    </a>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-3 py-2 rounded-pill mb-2">
            <i class="bi bi-tag-fill me-1"></i> @workshop.Code
        </span>
        <h1 class="h2 fw-bold text-dark mb-1">@workshop.Title</h1>
        <p class="text-muted mb-0">
            <i class="bi bi-calendar3 me-1"></i>@workshop.StartDateTime.ToString("dddd, dd MMMM yyyy · hh:mm tt")
        </p>
    </div>
    <div class="d-flex gap-2">
        <div class="card card-custom px-4 py-2 text-center">
            <small class="text-muted">Activos</small>
            <div class="fs-4 fw-bold text-success">@active.Count / @workshop.Capacity</div>
        </div>
        <div class="card card-custom px-4 py-2 text-center">
            <small class="text-muted">Cupos libres</small>
            <div class="fs-4 fw-bold text-primary">@workshop.AvailableSlots</div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card card-custom p-5 text-center">
        <div class="d-inline-flex p-3 rounded-circle bg-light text-muted mb-3 mx-auto">
            <i class="bi bi-people fs-1"></i>
        </div>
        <h4 class="fw-bold text-secondary">Todavía no hay participantes inscritos</h4>
        <p class="text-muted mb-0">Cuando alguien se inscriba en este taller aparecerá aquí.</p>
    </div>
}
else
{
    <div class="card card-custom border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="attendees-table">
                <thead class="table-light text-secondary small text-uppercase fw-semibold">
                    <tr>
                        <th class="ps-4 py-3">#</th>
                        <th class="py-3">Participante</th>
                        <th class="py-3">Correo</th>
                        <th class="py-3">Fecha de inscripción</th>
                        <th class="pe-4 py-3 text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var i = 1; }
                    @foreach (var a in active.Concat(cancelled))
                    {
                        var isActive = a.Status == "Active";
                        <tr class="@(isActive ? "" : "opacity-75")">
                            <td class="ps-4 py-3 text-muted small">@(i++)</td>
                            <td class="py-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
                                        @(string.IsNullOrWhiteSpace(a.ParticipantName) ? "?" : a.ParticipantName.Trim()[0].ToString().ToUpper())
                                    </div>
                                    <span class="fw-semibold text-dark">@a.ParticipantName</span>
                                </div>
                            </td>
                            <td class="py-3 small">
                                <a href="mailto:@a.ParticipantEmail" class="text-decoration-none">@a.ParticipantEmail</a>
                            </td>
                            <td class="py-3 small text-muted">@a.EnrolledAt.ToString("dd/MM/yyyy hh:mm tt")</td>
                            <td class="pe-4 py-3 text-center">
                                @if (isActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">Activa</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 rounded-pill">Cancelada</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
