@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card card-custom p-4 p-md-5 border-0 shadow-sm">
            <div class="text-center mb-4">
                <div class="d-inline-flex p-3 rounded-circle bg-success bg-opacity-10 text-success mb-3">
                    <i class="bi bi-shield-check fs-2"></i>
                </div>
                <h2 class="fw-bold mb-1">Nueva Contraseña</h2>
                <p class="text-muted small">Define una nueva contraseña segura para tu cuenta</p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger rounded-3 py-2 small">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-0"></div>
                </div>
            }

            <form asp-action="ResetPassword" method="post" novalidate>
                <input type="hidden" asp-for="Token" />

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-secondary small">Correo Electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" type="email" class="form-control border-start-0 ps-0 bg-light" readonly />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold text-secondary small">Nueva Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-key"></i>
                        </span>
                        <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="Mínimo 6 caracteres" required autofocus />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary small">Confirmar Nueva Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-key-fill"></i>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0" placeholder="Repite tu nueva contraseña" required />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
                    <i class="bi bi-check2-circle me-1"></i> Guardar Nueva Contraseña
                </button>

                <div class="text-center pt-2 border-top">
                    <a asp-action="Login" class="text-decoration-none fw-semibold text-muted small">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar y volver al inicio de sesión
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
