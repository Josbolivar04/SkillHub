@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card card-custom p-5 border-0 shadow-sm">
            <div class="d-inline-flex p-3 rounded-circle bg-danger bg-opacity-10 text-danger mb-4 mx-auto">
                <i class="bi bi-shield-slash-fill fs-1"></i>
            </div>
            <h2 class="fw-bold mb-2 text-danger">Acceso Denegado</h2>
            <p class="text-muted mb-4">No tienes los permisos necesarios para acceder a este recurso. Por favor verifica tu rol o inicia sesión con otra cuenta.</p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Workshops" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Volver a Talleres
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                </a>
            </div>
        </div>
    </div>
</div>
