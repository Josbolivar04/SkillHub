@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card card-custom p-4 p-md-5 border-0 shadow-sm">
            <div class="text-center mb-4">
                <div class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-10 text-primary mb-3">
                    <i class="bi bi-key-fill fs-2"></i>
                </div>
                <h2 class="fw-bold mb-1">¿Olvidaste tu Contraseña?</h2>
                <p class="text-muted small">Ingresa el correo electrónico asociado a tu cuenta para restablecer tu contraseña</p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger rounded-3 py-2 small">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-0"></div>
                </div>
            }

            <form asp-action="ForgotPassword" method="post" novalidate>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold text-secondary small">Correo Electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="tu.correo@ejemplo.com" required autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
                    <i class="bi bi-arrow-right-circle me-1"></i> Continuar
                </button>

                <div class="text-center pt-2 border-top">
                    <a asp-action="Login" class="text-decoration-none fw-semibold text-muted small">
                        <i class="bi bi-arrow-left me-1"></i> Volver a Iniciar Sesión
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
